# Server-side only: read by api/chat.ts (Vercel) and by `npm run dev` from .env.local.
# Never prefix these with VITE_: every VITE_* variable is bundled into the public site.

# Anthropic API key for the chatbot. Create one at https://console.anthropic.com/settings/keys
# and set a monthly spend limit there. On Vercel, add it for Production and Preview.
ANTHROPIC_API_KEY=your_api_key_here

# Optional. Model used by the chatbot (default: claude-haiku-4-5).
# CHAT_MODEL=claude-haiku-4-5
